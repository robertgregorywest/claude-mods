#!/usr/bin/env bash
# Manage the Claude Code mods in this repo.
#
# Install = point CLAUDE_CODE_PLUGIN_DIRS (in ~/.claude/settings.json) straight at
# mods/<name>. There is no copy step: interactive sessions watch those folders, so
# saving a file here hot-reloads the mod in every running session.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODS="${CLAUDE_MODS_DIR:-$ROOT/mods}"
# The mod layout lives here, as a working mod named mod-template: `new` copies it,
# and `check` checks it with the mods so it can't fall out of date.
TEMPLATE="$ROOT/template"
SETTINGS="${CLAUDE_SETTINGS:-$HOME/.claude/settings.json}"

die() { echo "mods: $*" >&2; exit 1; }

is_mod() { [[ -f "$MODS/$1/.claude-plugin/plugin.json" ]]; }

in_list() {
  local x="$1" y; shift
  for y in "$@"; do [[ "$x" == "$y" ]] && return 0; done
  return 1
}

all_mods() {
  for d in "$MODS"/*/; do
    is_mod "$(basename "$d")" && basename "$d"
  done
}

mod_dir() {
  is_mod "$1" || die "no mod named '$1' in $MODS"
  echo "$MODS/$1"
}

# Like mod_dir, but `template` names the template, for check and try.
check_dir() {
  if [[ "$1" == template ]]; then echo "$TEMPLATE"; else mod_dir "$1"; fi
}

# --- Installed set ------------------------------------------------------------
# The installed set is the repo entries in CLAUDE_CODE_PLUGIN_DIRS. An entry is a
# repo entry when, with ~ expanded and trailing slashes dropped, it is
# $MODS/<name>. Anything else is a foreign entry and is kept verbatim. A repo
# entry whose mod no longer exists is a dead entry: kept, and reported, until
# uninstalled. Only installed_mods and set_installed touch the setting.

settings_json() { if [[ -f "$SETTINGS" ]]; then cat "$SETTINGS"; else echo '{}'; fi; }

plugin_dirs() {
  settings_json | jq -r '.env.CLAUDE_CODE_PLUGIN_DIRS // ""' | tr ':' '\n' | sed '/^$/d'
}

# Prints the mod name if the entry is a repo entry; fails otherwise.
repo_name() {
  local d="${1/#\~/$HOME}"
  while [[ "$d" == */ ]]; do d="${d%/}"; done
  [[ "$d" == "$MODS/"* ]] || return 1
  d="${d#"$MODS/"}"
  [[ -n "$d" && "$d" != */* ]] || return 1
  echo "$d"
}

# Names of the installed set, dead entries included, sorted.
installed_mods() {
  local d
  while IFS= read -r d; do repo_name "$d" || true; done < <(plugin_dirs) | sort -u
}

# Make the installed set exactly <names...>: foreign entries first, in their
# original order, then repo entries sorted. Writes (and backs up) only on change.
set_installed() {
  local keep=() d m joined tmp
  while IFS= read -r d; do
    repo_name "$d" >/dev/null || keep+=("$d")
  done < <(plugin_dirs)
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    is_mod "$m" || echo "mods: keeping dead entry $MODS/$m (no such mod; 'bin/mods uninstall $m' drops it)" >&2
    keep+=("$MODS/$m")
  done < <(printf '%s\n' "$@" | sort -u)

  joined="$(IFS=:; echo "${keep[*]-}")"
  tmp="$(mktemp)"
  if [[ -n "$joined" ]]; then
    settings_json | jq --arg v "$joined" '.env.CLAUDE_CODE_PLUGIN_DIRS = $v | .env.CLAUDE_CODE_ENABLE_FUNCTION_HOOKS = "1"' > "$tmp"
  else
    settings_json | jq 'del(.env.CLAUDE_CODE_PLUGIN_DIRS)' > "$tmp"
  fi
  if [[ "$(jq -cS . "$tmp")" == "$(settings_json | jq -cS .)" ]]; then
    rm -f "$tmp"
    echo "CLAUDE_CODE_PLUGIN_DIRS unchanged"
    return
  fi
  [[ -f "$SETTINGS" ]] && cp "$SETTINGS" "$SETTINGS.mods-bak"
  mv "$tmp" "$SETTINGS"
  echo "CLAUDE_CODE_PLUGIN_DIRS=${joined:-<unset>}"
}

# --- Commands -----------------------------------------------------------------

cmd_list() {
  local m installed=()
  while IFS= read -r m; do installed+=("$m"); done < <(installed_mods)
  while IFS= read -r m; do
    if ! is_mod "$m"; then
      printf '%-20s %-10s %s\n' "$m" missing "(in settings, no such mod in this repo)"
      continue
    fi
    if in_list "$m" ${installed[@]+"${installed[@]}"}; then s=installed; else s=-; fi
    printf '%-20s %-10s %s\n' "$m" "$s" "$(jq -r .description "$MODS/$m/.claude-plugin/plugin.json")"
  done < <({ all_mods; printf '%s\n' ${installed[@]+"${installed[@]}"}; } | sed '/^$/d' | sort -u)
}

cmd_install() {
  local want=() m
  if (( $# == 0 )); then
    while IFS= read -r m; do want+=("$m"); done < <(all_mods)
  else
    for m in "$@"; do mod_dir "$m" >/dev/null; want+=("$m"); done
  fi
  while IFS= read -r m; do want+=("$m"); done < <(installed_mods)
  set_installed ${want[@]+"${want[@]}"}
  echo "Restart Claude Code sessions to pick up newly added mods; edits to installed ones hot-reload."
}

cmd_uninstall() {
  local installed=() keep=() m
  while IFS= read -r m; do installed+=("$m"); done < <(installed_mods)
  if (( $# )); then
    for m in "$@"; do
      is_mod "$m" || in_list "$m" ${installed[@]+"${installed[@]}"} \
        || die "no mod named '$m' in $MODS or in CLAUDE_CODE_PLUGIN_DIRS"
    done
    for m in ${installed[@]+"${installed[@]}"}; do
      in_list "$m" "$@" || keep+=("$m")
    done
  fi
  set_installed ${keep[@]+"${keep[@]}"}
}

# The test loop: validate -> type-check -> tests, per mod. Exit non-zero on any failure.
cmd_check() {
  local mods=("$@") m dir failed=()
  (( ${#mods[@]} )) || mods=($(all_mods) template)
  for m in "${mods[@]}"; do
    dir="$(check_dir "$m")"
    echo "== $m"
    local ok=1
    echo "-- validate"; claude plugin validate "$dir" || ok=0
    echo "-- tsc"
    if [[ -f "$dir/.claude-plugin/types/tsconfig.json" ]]; then
      npx --yes -p typescript@5 tsc -p "$dir" || ok=0
    else
      echo "skipped: types not laid yet (the engine writes .claude-plugin/types/ the first time it loads the mod — install it, or run 'bin/mods try' on it)"
    fi
    echo "-- test"
    if compgen -G "$dir/hooks/*.test.ts*" >/dev/null || compgen -G "$dir/tests/*.test.ts*" >/dev/null; then
      claude plugin test "$dir" || ok=0
    else
      echo "no tests found"; ok=0
    fi
    (( ok )) || failed+=("$m")
  done
  if (( ${#failed[@]} )); then echo; echo "FAILED: ${failed[*]}"; exit 1; fi
  echo; echo "all checks passed"
}

cmd_new() {
  local name="${1:-}" desc="${2:-TODO: one line}"
  [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "usage: mods new <kebab-name> [description]"
  [[ "$name" == template ]] && die "'template' is reserved for the template"
  local dir="$MODS/$name" tmp f
  [[ -e "$dir" ]] && die "$dir already exists"
  tmp="$(mktemp)"
  mkdir -p "$MODS"
  cp -R "$TEMPLATE" "$dir"
  rm -rf "$dir/.claude-plugin/types"
  while IFS= read -r f; do
    sed "s/mod-template/$name/g" "$f" > "$tmp" && cat "$tmp" > "$f"
  done < <(grep -rl mod-template "$dir")
  jq --arg d "$desc" '.description = $d' "$dir/.claude-plugin/plugin.json" > "$tmp"
  cat "$tmp" > "$dir/.claude-plugin/plugin.json"
  rm -f "$tmp"
  echo "created $dir"
  echo "next: write the mod and its tests, then 'bin/mods check $name' and 'bin/mods install $name'"
}

cmd_try() {
  # One-off session with only this mod loaded from the repo, without installing it.
  local dir; dir="$(check_dir "${1:?usage: mods try <name> [claude args...]}")"; shift
  exec claude --plugin-dir "$dir" "$@"
}

usage() {
  cat <<EOF
usage: bin/mods <command> [args]

  list                     mods in this repo and whether they're installed
  install [name...]        point CLAUDE_CODE_PLUGIN_DIRS at repo mods (all if none named)
  uninstall [name...]      remove repo mods from CLAUDE_CODE_PLUGIN_DIRS (all if none named)
  check [name...]          validate + type-check + run tests (all mods and the template if none named)
  new <name> [desc]        scaffold a new mod by copying template/
  try <name> [args...]     start claude with just this mod via --plugin-dir
EOF
}

case "${1:-}" in
  list) shift; cmd_list "$@" ;;
  install) shift; cmd_install "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  check) shift; cmd_check "$@" ;;
  new) shift; cmd_new "$@" ;;
  try) shift; cmd_try "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
